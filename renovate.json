{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang",
        "toolchain"
      ],
      "groupName": "Go"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump",
      "extractVersion": "^(?<version>\\d+\\.\\d+)\\.\\d+$",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)$"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDatasources": [
        "go"
      ],
      "enabled": true
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/**", "github.com/openshift/**"],
      "groupName": "Kubernetes and OpenShift"
    },
    {
      "description": "Use the kube-openapi revision selected by Kubernetes; its main branch already uses structured-merge-diff v7.",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["k8s.io/kube-openapi"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.custom-gcl\\.yml$/"
      ],
      "matchStrings": [
        "version: (?<currentValue>v[0-9.]+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+\\s*[:?]?=\\s*(?<currentValue>v?[0-9][^\\s]+)"
      ]
    }
  ]
}
